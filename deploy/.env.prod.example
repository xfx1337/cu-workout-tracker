# Шаблон .env для продакшена. Скопируй в корень проекта как .env и заполни.
# Отличия от локального: другой пароль базы и порт Postgres наружу не пробрасываем.

# --- Telegram ---
BOT_TOKEN=сюда_токен_от_BotFather

# Админы бота: telegram username без @, через запятую
ADMIN_USERNAMES=xfx1337

# --- База ---
# Внутри docker compose адрес всегда db:5432, значение ниже перебивается автоматически.
DATABASE_URL=postgresql+asyncpg://workout:ЗАМЕНИ_ПАРОЛЬ@db:5432/workout

POSTGRES_USER=workout
POSTGRES_PASSWORD=ЗАМЕНИ_ПАРОЛЬ
POSTGRES_DB=workout
POSTGRES_PORT=5432

# --- Время ---
TZ_NAME=Europe/Moscow

# --- Авторизация (ручка ЦУ) ---
# Пусто => заглушка, пускает всех. Перед реальным запуском для студентов заполни.
AUTH_API_URL=
AUTH_API_TOKEN=
AUTH_LOGIN_URL=

# --- Правила записи ---
DEFAULT_CAPACITY=25
REMINDER_MINUTES_BEFORE=30
CANCEL_DEADLINE_MINUTES=0
NO_SHOW_LIMIT=3
SILENCE_GRACE_HOURS=24
SELF_REPORTED_ABSENCE_COUNTS=false
SILENCE_COUNTS=true
