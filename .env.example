# --- Mattermost (TiMe) ---
MM_URL=https://time.example.ru
MM_TOKEN=personal_access_token_бот_аккаунта
MM_TEAM=

# Публичный адрес ручки, по которой сервер Mattermost присылает клики по кнопкам.
# Задан  => экраны рисуются кнопками, диалог живёт в одном сообщении.
# Пусто  => запасной режим: выбор реакциями-эмодзи, входящий порт не нужен.
MM_PUBLIC_URL=https://workout.example.ru
MM_LISTEN_PORT=8080

# Домен для встроенного Caddy (docker-compose.caddy.yml).
# Если обратный прокси на сервере уже свой — не нужен.
BOT_DOMAIN=workout.example.ru

# Образ бота. Подставляется автоматически при выкладке из GitLab CI,
# локально можно не задавать — соберётся из исходников.
# BOT_IMAGE=registry.gitlab.example/группа/проект/bot:latest

# Админы бота: корпоративная почта через запятую.
# Почта, а не username: username в Mattermost человек может сменить сам.
ADMIN_EMAILS=olya@centraluniversity.ru

# --- База ---
# Внутри docker compose адрес всегда db:5432 — значение ниже перебивается.
DATABASE_URL=postgresql+asyncpg://workout:workout@127.0.0.1:5432/workout

POSTGRES_USER=workout
POSTGRES_PASSWORD=смени_на_длинный_случайный
POSTGRES_DB=workout
POSTGRES_PORT=5432

# --- Время ---
TZ_NAME=Europe/Moscow

# --- Правила записи ---
DEFAULT_CAPACITY=25
REMINDER_MINUTES_BEFORE=30
CANCEL_DEADLINE_MINUTES=0
NO_SHOW_LIMIT=3
SILENCE_GRACE_HOURS=24
SELF_REPORTED_ABSENCE_COUNTS=false
SILENCE_COUNTS=true

# Опрос TiMe: WebSocket там недоступен (ingress режет upgrade),
# события забираются периодическим REST-запросом.
POLL_INTERVAL_SECONDS=2
