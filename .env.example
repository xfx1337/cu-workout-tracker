# --- Telegram ---
BOT_TOKEN=123456:AA...

# Админы бота: telegram username без @, через запятую.
# Эти аккаунты автоматически получат права при старте бота.
ADMIN_USERNAMES=olya_cu,my_username

# --- База ---
# В docker compose DATABASE_URL задаётся автоматически и указывает на сервис db,
# это значение там перебивается. Оно нужно для запуска без Docker.
DATABASE_URL=postgresql+asyncpg://workout:workout@127.0.0.1:5432/workout
# для локального прогона без базы можно так:
# DATABASE_URL=sqlite+aiosqlite:///./workout.db

# Реквизиты Postgres для docker compose (совпадают со значениями по умолчанию)
POSTGRES_USER=workout
POSTGRES_PASSWORD=workout
POSTGRES_DB=workout
POSTGRES_PORT=5432

# --- Время ---
TZ_NAME=Europe/Moscow

# --- Авторизация (ручка ЦУ) ---
# Пока пусто => работает заглушка: любой пользователь получает student_id вида stub-<tg_id>
AUTH_API_URL=
AUTH_API_TOKEN=
# Ссылка, куда отправляем студента логиниться (в заглушке не используется)
AUTH_LOGIN_URL=

# --- Правила записи ---
DEFAULT_CAPACITY=25
# за сколько минут до старта присылать напоминание
REMINDER_MINUTES_BEFORE=30
# за сколько минут до старта закрывается отмена (0 = можно отменить вплоть до начала)
CANCEL_DEADLINE_MINUTES=0
# сколько неявок до автоматической блокировки
NO_SHOW_LIMIT=3
# сколько часов ждём ответа на опрос "как прошла тренировка" перед авто-неявкой
SILENCE_GRACE_HOURS=24
# считать ли страйком честный ответ "не смог прийти" (по умолчанию нет — не наказываем за честность)
SELF_REPORTED_ABSENCE_COUNTS=false
# считать ли страйком молчание после опроса
SILENCE_COUNTS=true
